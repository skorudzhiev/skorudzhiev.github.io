{
  "name": "stoyan-korudzhiev-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:indie": "node scripts/verify-indie.mjs",
    "test:indie:browser": "playwright test --config=playwright.indie.config.ts",
    "test:indie:visual:update": "UPDATE_INDIE_BASELINES=1 playwright test --config=playwright.indie.config.ts --grep visual-baseline",
    "verify": "npm run build && npm run test:indie && npm run test:indie:browser"
  },
  "dependencies": {
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@playwright/test": "^1.62.1",
    "typescript": "latest"
  }
}
