<button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
  <span class="theme-toggle__track" aria-hidden="true">
    <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="14" height="14">
      <circle cx="12" cy="12" r="3.25"></circle>
      <path d="M12 2.25v2M12 19.75v2M2.25 12h2M19.75 12h2M5.1 5.1l1.4 1.4M17.5 17.5l1.4 1.4M18.9 5.1l-1.4 1.4M6.5 17.5l-1.4 1.4"></path>
    </svg>
    <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="14" height="14">
      <path d="M20.25 15.15A8.5 8.5 0 0 1 8.85 3.75a8.5 8.5 0 1 0 11.4 11.4Z"></path>
    </svg>
    <span class="theme-toggle__thumb"></span>
  </span>
</button>

<script>
  const storageKey = "stoyan-theme";
  const root = document.documentElement;

  function themeColor(theme: "light" | "dark") {
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    return theme === "dark"
      ? meta?.dataset.darkColor ?? "#151715"
      : meta?.dataset.lightColor ?? "#f2efe7";
  }

  function updateThemeControls(theme: "light" | "dark") {
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((toggle) => {
      const nextTheme = theme === "dark" ? "light" : "dark";
      const label = `Switch to ${nextTheme} theme`;
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
    });
  }

  function applyTheme(theme: "light" | "dark", persist = true) {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute("content", themeColor(theme));

    if (persist) {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {}
    }

    updateThemeControls(theme);
  }

  updateThemeControls(root.dataset.theme === "dark" ? "dark" : "light");

  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
    });
  });
</script>

<style>
  .theme-toggle {
    flex: none;
    width: 52px;
    height: 32px;
    padding: 3px;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper-deep) 78%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .theme-toggle:hover {
    border-color: color-mix(in srgb, var(--signal) 58%, var(--line));
    transform: translateY(-1px);
  }

  .theme-toggle__track {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .theme-toggle__icon {
    position: relative;
    z-index: 1;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
    transition: color 160ms ease;
  }

  .theme-toggle__icon--sun {
    margin-left: 3px;
    color: var(--signal-dark);
  }

  .theme-toggle__icon--moon {
    margin-right: 3px;
    color: var(--muted);
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 24px;
    height: 24px;
    background: var(--paper-bright, var(--cream));
    border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: 0 3px 9px rgba(20, 20, 18, 0.16);
    transition: transform 180ms ease, background 180ms ease;
  }

  :global(html[data-theme="dark"]) .theme-toggle__thumb {
    background: var(--night-soft);
    transform: translateX(20px);
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--sun {
    color: var(--muted);
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--moon {
    color: var(--signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle__icon,
    .theme-toggle__thumb {
      transition: none;
    }
  }
</style>
