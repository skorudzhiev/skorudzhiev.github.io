---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../site-config";

const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "https://formspree.io/f/xrenakkk";
---

<BaseLayout title="Work with me" description="Contact Stoyan Korudzhiev about Android or frontend contract work, a mobile or web product build, an Android codebase review, or a senior or lead role.">
  <header class="page-intro start-page-intro shell">
    <p class="eyebrow">Work with me</p>
    <h1>Tell me what you need.<br />A few sentences is enough.</h1>
    <p class="page-lede">This could be a contract, a product build, a codebase review, or a senior or lead role. Tell me what you're working on and what would help, and I'll reply by email.</p>
  </header>

  <section class="form-shell form-shell--compact shell">
    <aside class="form-context">
      <p><strong>Good fits:</strong>Android contract or lead work, Vue and TypeScript frontend work, a focused mobile or web MVP, or a fixed-scope review of an Android codebase.</p>
      <p><strong>What happens next:</strong>I'll read your message and reply by email, usually within a few working days. If I'm not the right person, I'll say so.</p>
      <p><strong>Want the background first?</strong><a href="/cv/">Read my CV</a></p>
      <p><strong>Prefer email?</strong><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
    </aside>

    <form class="project-form" action={formEndpoint} method="POST" data-endpoint={formEndpoint} novalidate>
      <div class="honeypot" aria-hidden="true">
        <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field field--full">
        <label for="topic">What is this about?</label>
        <select id="topic" name="topic" required>
          <option value="">Choose one</option>
          <option>Android contract or tech-lead work</option>
          <option>Frontend contract work (Vue, TypeScript, Phaser)</option>
          <option>Mobile or web product build</option>
          <option>Android codebase review</option>
          <option>Senior or lead role</option>
          <option>Something else</option>
        </select>
      </div>
      <div class="field field--full"><label for="context">What are you working on, and what would help?</label><textarea id="context" name="context" required></textarea></div>
      <div class="field field--full"><label for="company">Company, product, or job link <span class="field-help">(optional)</span></label><input id="company" name="company" type="url" inputmode="url" placeholder="https://" /></div>
      <div class="field"><label for="budget">Budget or rate range <span class="field-help">(optional)</span></label><input id="budget" name="budget" placeholder="A range is enough" /></div>
      <div class="field"><label for="timing">Timing <span class="field-help">(optional)</span></label><input id="timing" name="timing" placeholder="Start date or general window" /></div>

      <input type="hidden" name="_subject" value="Work enquiry from skorudzhiev.github.io" />
      <input type="hidden" name="inquiry_source" value="Personal website — Work with me" />
      <div class="form-actions">
        <button class="button button--primary" type="submit" data-default-label="Send message" data-pending-label="Sending">
          <span class="submit-label">Send message</span> <span aria-hidden="true">↗</span>
        </button>
        <span class="form-privacy">Your details are used only to reply to this conversation.</span>
      </div>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <script is:inline define:vars={{ fallbackEmail: siteConfig.email }}>
    const form = document.querySelector(".project-form");
    const status = form?.querySelector(".form-status");
    const submitButton = form?.querySelector('button[type="submit"]');
    const submitLabel = submitButton?.querySelector(".submit-label");

    const setStatus = (message, state = "") => {
      if (!status) return;
      status.className = `form-status${state ? ` form-status--${state}` : ""}`;
      status.textContent = message;
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (data.get("_gotcha")) return;
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        const lines = [
          `Name: ${data.get("name")}`,
          `Email: ${data.get("email")}`,
          `Topic: ${data.get("topic")}`,
          `Company / product / job link: ${data.get("company") || "Not provided"}`,
          "",
          "What I'm working on and what would help:",
          String(data.get("context")),
          "",
          `Budget or rate range: ${data.get("budget") || "Not provided"}`,
          `Timing: ${data.get("timing") || "Not provided"}`,
        ];
        window.location.href = `mailto:${fallbackEmail}?subject=${encodeURIComponent("Work enquiry")}&body=${encodeURIComponent(lines.join("\n"))}`;
        setStatus("Your email app should open with the brief prepared. You can also email me directly if it does not.");
        return;
      }

      submitButton.disabled = true;
      form.setAttribute("aria-busy", "true");
      if (submitLabel) submitLabel.textContent = submitButton.dataset.pendingLabel;
      setStatus("Sending your message…");
      try {
        const response = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("Submission failed");
        form.reset();
        setStatus("Thank you, your message has been sent. I'll reply by email.", "success");
      } catch {
        setStatus(`That did not send. Please email ${fallbackEmail} instead.`, "error");
      } finally {
        submitButton.disabled = false;
        form.removeAttribute("aria-busy");
        if (submitLabel) submitLabel.textContent = submitButton.dataset.defaultLabel;
      }
    });
  </script>
</BaseLayout>
