---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import WritingCard from "../components/WritingCard.astro";
import { roles } from "../data/experience";
import { siteConfig } from "../site-config";

const work = (await getCollection("work")).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection("writing"))
  .filter((article) => article.data.featured)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);
const continuum = work.find((project) => project.id === "continuum")!;
const supportingWork = work.filter((project) => project.id !== "continuum");
---

<BaseLayout>
  <section class="hero home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Senior Software Engineer · Android tech lead</p>
        <h1>Senior Android engineer who <em>ships</em> across mobile, web, and desktop.</h1>
        <p class="hero-lede">
          I've spent 7+ years building production Android apps for fintech, health tech, and iLottery, and about two years of that leading an Android team. Today I also build frontends in Vue, TypeScript, and Phaser, and I ship my own products on the side.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="/cv/">View my CV <span aria-hidden="true">→</span></a>
          <a class="button button--secondary" href="/start/">Work with me</a>
        </div>
        <p class="availability-note">{siteConfig.availabilityNote}</p>
      </div>

      <div class="systems-card" aria-label="Track record at a glance">
        <div class="systems-card-header">
          <span>Track record</span>
          <span>2019—now</span>
        </div>
        <div class="system-stack">
          <div class="system-layer">
            <span>Scale</span>
            <strong>Android work on a payments app with 5M+ active users at SumUp.</strong>
          </div>
          <div class="system-layer">
            <span>Leadership</span>
            <strong>Led the Android team on a white-label iLottery product, with ~90% test coverage.</strong>
          </div>
          <div class="system-layer">
            <span>Range</span>
            <strong>Four products of my own shipped on desktop, browser, mobile, and web.</strong>
          </div>
        </div>
        <div class="system-output">Kotlin · Compose · Vue · TypeScript <b>shipping</b></div>
      </div>
    </div>
  </section>

  <div class="capability-band" aria-label="Areas of work">
    <div class="shell capability-list">
      <span>Android &amp; Kotlin</span><i>·</i>
      <span>Jetpack Compose</span><i>·</i>
      <span>Android tech leadership</span><i>·</i>
      <span>Vue, TypeScript &amp; Phaser</span><i>·</i>
      <span>Architecture &amp; testing</span><i>·</i>
      <span>AI-assisted engineering &amp; MCP</span>
    </div>
  </div>

  <section class="section home-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Experience</p>
          <h2>Production apps.<br />Real users.</h2>
        </div>
        <p>Payments, digital banking, health tracking, and iLottery. These are regulated, high-traffic products where reliability, security, and maintainable architecture actually matter.</p>
      </div>
      <ol class="experience-strip">
        {roles.map((role) => (
          <li>
            <span>{role.start} – {role.end}</span>
            <strong>{role.company}</strong>
            <em>{role.title}</em>
            <small>{role.industry}</small>
          </li>
        ))}
      </ol>
      <div class="section-link-row">
        <a class="text-link" href="/cv/">Read the full CV <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section home-section" id="services">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How I can help</p>
          <h2>Senior hands.<br />Clear scope.</h2>
        </div>
        <p>Three concrete ways to work together: as a contract or lead engineer on your team, as the builder of a focused product, or as an outside reviewer of your codebase.</p>
      </div>
      <div class="service-grid">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </div>
      <div class="section-link-row">
        <a class="text-link" href="/services/">See services in detail <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section home-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Independent product</p>
          <h2>Built end to end,<br />on my own time.</h2>
        </div>
        <p>Continuum is my largest independent product. I built the web app, a signed macOS desktop app with Windows and Linux builds, the documentation, and the release pipeline.</p>
      </div>

      <article class="continuum-feature">
        <div class="continuum-copy">
          <p class="eyebrow">{continuum.data.stage} · {continuum.data.year}</p>
          <h2>Think it through.<br />Watch the numbers move.</h2>
          <p>{continuum.data.summary}</p>
          <div class="continuum-scope">
            {continuum.data.capabilities.map((capability) => <span>{capability}</span>)}
          </div>
          <div class="button-row">
            <a class="button button--primary" href="/work/continuum/">Read the case study</a>
            <a class="button button--secondary" href={continuum.data.externalUrl} target="_blank" rel="noopener">View Continuum ↗</a>
          </div>
        </div>

        <div class="workspace-preview" aria-label="A simplified public preview of the Continuum calculation workspace">
          <div class="workspace-window">
            <div class="workspace-toolbar">
              <span><img src={continuum.data.image} alt="" width="24" height="24" />Continuum</span>
              <span>Monthly plan</span>
            </div>
            <div class="workspace-body">
              <div class="workspace-editor">
                <pre># A living monthly plan
income = 5200 in usd
rent = 1650 in usd
groceries = 620 in usd
flexible = 12% of income

<mark>remaining = income - rent -
groceries - flexible</mark></pre>
              </div>
              <div class="workspace-results">
                <small>Live results</small>
                <output>$5,200.00</output>
                <output>$1,650.00</output>
                <output>$620.00</output>
                <output><strong>$2,306.00</strong></output>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section home-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">More shipped products</p>
          <h2>Different platforms.<br />Same ownership.</h2>
        </div>
        <p>A desktop Git client in Rust and Tauri, a Chrome extension with paid plans, and a mobile and web product built with Expo and Next.js.</p>
      </div>
      <div class="work-grid">
        {supportingWork.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </div>
  </section>

  <section class="section home-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Ideas and field notes</p>
          <h2>I write about how I build.</h2>
        </div>
        <p>Notes on architecture, AI-assisted engineering, MCP integrations, and what happens after something ships.</p>
      </div>
      <div class="writing-grid">
        {writing.map((article) => <WritingCard article={article} featured />)}
      </div>
      <div class="section-link-row"><a class="text-link" href="/writing/">Read all writing <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section home-section">
    <div class="shell about-strip">
      <aside class="practice-map" aria-label="How the practice expanded from Android into broader engineering work">
        <div class="practice-map__header">
          <span>Practice map</span>
          <span>2019—now</span>
        </div>
        <ol class="practice-map__path">
          <li class="practice-map__origin"><span>2019</span><strong>Android</strong></li>
          <li><span>2024</span><strong>Tech lead</strong></li>
          <li><span>2025</span><strong>Own products</strong></li>
          <li><span>2026</span><strong>Vue + Phaser</strong></li>
        </ol>
      </aside>
      <div class="about-copy">
        <p class="eyebrow">How I work</p>
        <h2>Android depth, with AI in the workflow.</h2>
        <p>Mobile engineering taught me to care about constraints, explicit states, performance, and the last mile between code and a real person. I use AI coding agents every day to explore, implement, and test faster, and I review everything they produce before it ships.</p>
        <a class="text-link" href="/about/">More about how I got here <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="closing-cta home-closing-cta">
    <div class="shell closing-cta-grid">
      <div>
        <p class="eyebrow">Let's talk</p>
        <h2>Need a senior Android or frontend engineer?</h2>
        <p>Tell me about the role, the contract, or the codebase. A few sentences are enough to start.</p>
      </div>
      <a class="button" href="/start/">Work with me <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
