---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../site-config";
import { earlierRoles, education, independentWork, profile, roles, skillGroups } from "../../data/experience";
---

<BaseLayout
  title="CV"
  description="CV for Stoyan Korudzhiev: Senior Software Engineer with 7+ years of production Android work in fintech, health tech, and iLottery, Android tech lead experience, and current Vue, TypeScript, and Phaser frontend work."
>
  <header class="page-intro cv-intro shell">
    <p class="eyebrow">Curriculum vitae</p>
    <h1>{siteConfig.name}</h1>
    <p class="cv-headline">{profile.headline} <span>·</span> {profile.focus}</p>
    <p class="page-lede">{profile.summary}</p>
    <ul class="cv-contact" aria-label="Contact details">
      <li>{profile.location}</li>
      <li><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
      <li><a href={siteConfig.social.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a></li>
      <li><a href={siteConfig.social.github} rel="me noopener" target="_blank">GitHub ↗</a></li>
    </ul>
    <div class="button-row cv-actions">
      <button class="button button--primary" type="button" data-print-cv>Save as PDF</button>
      <a class="button button--secondary" href="/start/">Work with me <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <section class="cv-section shell" aria-labelledby="cv-experience">
    <h2 id="cv-experience" class="cv-section-title">Experience</h2>
    <div class="cv-roles">
      {roles.map((role) => (
        <article class="cv-role">
          <div class="cv-role-meta">
            <p class="cv-dates">{role.start} – {role.end}</p>
            <p>{role.industry}</p>
            <p>{role.location}</p>
          </div>
          <div class="cv-role-body">
            <h3>{role.title}</h3>
            <p class="cv-company">{role.company}</p>
            <p>{role.summary}</p>
            <ul>{role.highlights.map((item) => <li>{item}</li>)}</ul>
            <p class="cv-stack">{role.stack.join(" · ")}</p>
          </div>
        </article>
      ))}

      <article class="cv-role cv-role--independent">
        <div class="cv-role-meta">
          <p class="cv-dates">{independentWork.start} – {independentWork.end}</p>
          <p>Alongside full-time work</p>
        </div>
        <div class="cv-role-body">
          <h3>{independentWork.title}</h3>
          <p>{independentWork.summary}</p>
          <ul>{independentWork.highlights.map((item) => <li>{item}</li>)}</ul>
          <p class="cv-stack"><a class="text-link" href="/work/">See the products <span aria-hidden="true">→</span></a></p>
        </div>
      </article>

      {earlierRoles.map((role) => (
        <article class="cv-role cv-role--earlier">
          <div class="cv-role-meta">
            <p class="cv-dates">{role.start} – {role.end}</p>
          </div>
          <div class="cv-role-body">
            <h3>{role.title}</h3>
            <p class="cv-company">{role.company}</p>
            <p>{role.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cv-section shell" aria-labelledby="cv-skills">
    <h2 id="cv-skills" class="cv-section-title">Skills</h2>
    <dl class="cv-skills">
      {skillGroups.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.items.join(" · ")}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="cv-section shell" aria-labelledby="cv-education">
    <h2 id="cv-education" class="cv-section-title">Education &amp; certification</h2>
    <ul class="cv-education">
      {education.map((item) => (
        <li><strong>{item.title}</strong><span>{item.org}</span><span>{item.year}</span></li>
      ))}
    </ul>
  </section>

  <script>
    document.querySelector("[data-print-cv]")?.addEventListener("click", () => window.print());
  </script>
</BaseLayout>

<style>
  .cv-intro h1 {
    font-size: clamp(2.6rem, 5vw, 4.4rem);
  }

  .cv-headline {
    margin: 1rem 0 0;
    color: var(--signal-dark);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 700;
  }

  .cv-headline span {
    color: var(--muted);
  }

  .cv-intro .page-lede {
    margin: 1.25rem 0 0;
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 1.5rem 0 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.92rem;
    list-style: none;
  }

  .cv-contact a {
    color: var(--ink);
  }

  .cv-section {
    padding: 2.5rem 0 3.5rem;
    border-top: 1px solid var(--line);
  }

  .cv-section-title {
    margin: 0 0 2rem;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
  }

  .cv-roles {
    display: grid;
    gap: 0;
  }

  .cv-role {
    display: grid;
    grid-template-columns: minmax(160px, 0.32fr) 1fr;
    gap: 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
    break-inside: avoid;
  }

  .cv-role:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .cv-role-meta p {
    margin: 0 0 0.25rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .cv-role-meta .cv-dates {
    color: var(--ink);
    font-weight: 700;
  }

  .cv-role-body h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .cv-company {
    margin: 0.2rem 0 0.75rem;
    color: var(--signal-dark);
    font-weight: 700;
  }

  .cv-role-body > p {
    margin: 0 0 0.75rem;
  }

  .cv-role-body ul {
    margin: 0 0 0.75rem;
    padding-left: 1.1rem;
  }

  .cv-role-body li {
    margin-bottom: 0.35rem;
  }

  .cv-stack {
    color: var(--muted);
    font-size: 0.86rem;
  }

  .cv-role--earlier .cv-role-body > p:last-child {
    color: var(--muted);
  }

  .cv-skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2.5rem;
    margin: 0;
  }

  .cv-skills dt {
    margin-bottom: 0.3rem;
    font-weight: 750;
  }

  .cv-skills dd {
    margin: 0;
    color: var(--muted);
  }

  .cv-education {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv-education li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1.5rem;
  }

  .cv-education span {
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .cv-role,
    .cv-skills {
      grid-template-columns: 1fr;
    }

    .cv-role {
      gap: 0.5rem;
    }

    .cv-education li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .cv-actions {
      display: none !important;
    }

    :global(html),
    :global(html[data-theme="dark"]) {
      --paper: #fff;
      --ink: #111;
      --muted: #444;
      --line: #ccc;
      --signal-dark: #a53a28;
    }

    :global(html),
    :global(body) {
      color: #000 !important;
      background: #fff !important;
      font-size: 11pt;
    }

    .cv-intro {
      padding: 0 0 1rem;
    }

    .cv-section {
      padding: 1rem 0;
    }

    .cv-role {
      padding: 0.9rem 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
